# 运行产物
gateway-run/
*.log

# 本地配置（含令牌，绝不入库）
gateway/config.json
gateway/config.local.json

# 打包产物
*.tar.gz
*.tgz

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 依赖（本仓库零依赖，这些只防误提交）
node_modules/

# ── 本地模型与运行时（体积大，绝不入库）────────────────────────────
# RVC 源码入库；只排除 assets 下的权重文件，各权重目录用 .gitkeep 保留空壳
sing-model/rvc/assets/**
!sing-model/rvc/assets/**/
!sing-model/rvc/assets/**/.gitkeep
# 下面这些是"机器上跑出来的东西"
sing-model/downloads/
sing-model/tmp/
sing-model/out/
sing-model/bin/
sing-model/voices/
sing-model/__pycache__/
*.pth
*.pt
*.ckpt
*.index
*.onnx
*.safetensors
*.whl
# ── 说话模型（Breeze TTS 2）：代码入库，权重只留空壳/下载/产物不入库 ──────────
say-model/weights/**
!say-model/weights/**/
!say-model/weights/**/.gitkeep
say-model/downloads/
say-model/outputs/
__pycache__/
*.pyc
say-model/.venv/
# ── 说话：参考音频与试听样本（含使用者音色，绝不入库）─────────────────
say-model/ref/
# 本地模型进程日志 / pid
say-model/logs/
*.pid
# 虚拟环境（谁建谁用，别提交）
.venv/
venv/
# 体检/试听临时产物
say-model/*.crdownload

# 语气 A/B 测试临时产物（音频、脚本、补丁）
test/tmp-tone-ab/
